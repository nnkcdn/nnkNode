# Nanako 节点后端 · 环境变量 (复制到 Coolify 的 Environment Variables 面板)
# 标 [必填] 的必须设置, 其余有默认值.

# ── 必填 ──
API_HOST=https://panel.example.com    # [必填] 面板地址
API_KEY=your-node-token               # [必填] 节点通信密钥
NODE_ID=1                             # [必填] 节点 ID (数字)
NODE_TYPE=vless                       # [必填] vmess/vless/trojan/shadowsocks/hysteria2/tuic

# ── 内核 ──
CORE_TYPE=xray                        # xray(默认,推荐) / sing / hysteria2
LOG_LEVEL=info                       # debug/info/warn/error
# XRAY_LOG_LEVEL=warning
# SING_LOG_LEVEL=error

# ── 网络/上报 ──
API_TIMEOUT=30
LISTEN_IP=0.0.0.0
SEND_IP=0.0.0.0
DEVICE_ONLINE_MIN_TRAFFIC=100
REPORT_MIN_TRAFFIC=0

# ── TLS 证书 ──
CERT_MODE=none                       # none / file / dns / http
# CERT_DOMAIN=node.example.com
# CERT_FILE=/etc/nanako-node/cert/fullchain.cer   # file 模式: 把证书挂进这个路径
# CERT_KEY_FILE=/etc/nanako-node/cert/private.key
# REJECT_UNKNOWN_SNI=false

# dns 模式 (自动签发) 示例 —— Cloudflare:
# CERT_MODE=dns
# CERT_PROVIDER=cloudflare
# CERT_EMAIL=you@example.com
# DNSENV_CF_DNS_API_TOKEN=你的CF_token
#   说明: 凡是 DNSENV_ 前缀的变量, 会去掉前缀注入给 ACME DNS provider.
#   其他厂商同理, 例如阿里: CERT_PROVIDER=alidns + DNSENV_ALICLOUD_ACCESS_KEY / DNSENV_ALICLOUD_SECRET_KEY

# ── DNS (可选) ──
# DNS_SERVERS=8.8.8.8,1.1.1.1       # 逗号分隔; 不设则用系统 DNS

# ── 健康检查 (可选) ──
# HEALTHCHECK_PORT=443               # 设了就额外探测该 TCP 端口是否监听

# ── 高级: 直接提供整份配置 (会忽略以上所有变量) ──
# CONFIG_JSON={"Log":{"Level":"info"},"Cores":[...],"Nodes":[...]}
